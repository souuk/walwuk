-sEXPORTED_FUNCTIONS=_walwuk_analyze,_walwuk_snapshot,_walwuk_result
-sEXPORTED_RUNTIME_METHODS=UTF8ToString
-sINITIAL_MEMORY=100663296
-sALLOW_MEMORY_GROWTH=0
-sSTACK_SIZE=1048576
-sFILESYSTEM=0
-sASSERTIONS=0
-sNO_EXIT_RUNTIME=1
-o
public/engine/walwuk-engine.mjs
