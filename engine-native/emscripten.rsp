engine-native/walwuk_engine.cpp
-std=c++20
-Wall
-Wextra
-Wpedantic
-Werror
-O3
-flto
-DNDEBUG
-fno-exceptions
-fno-rtti
--no-entry
-sMODULARIZE=1
-sEXPORT_ES6=1
